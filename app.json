  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Power station came back online"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=power_station"
          }
        ],
        "id": "came_online"
      },
      {
        "title": {
          "en": "An output was turned on or off"
        },
        "titleFormatted": {
          "en": "[[output]] was turned on or off"
        },
        "tokens": [
          {
            "name": "state",
            "type": "boolean",
            "title": {
              "en": "On"
            },
            "example": true
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=power_station"
          },
          {
            "type": "dropdown",
            "name": "output",
            "title": {
              "en": "Output"
            },
            "values": [
              {
                "id": "ac",
                "title": {
                  "en": "AC output"
                }
              },
              {
                "id": "dc",
                "title": {
                  "en": "DC output"
                }
              },
              {
                "id": "ac_eco",
                "title": {
                  "en": "AC ECO"
                }
              },
              {
                "id": "dc_eco",
                "title": {
                  "en": "DC ECO"
                }
              }
            ]
          }
        ],
        "id": "output_changed"
      },
      {
        "title": {
          "en": "Power station went offline"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=power_station"
          }
        ],
        "id": "went_offline"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Output is !{{on|off}}"
        },
        "titleFormatted": {
          "en": "[[output]] is !{{on|off}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=power_station"
          },
          {
            "type": "dropdown",
            "name": "output",
            "title": {
              "en": "Output"
            },
            "values": [
              {
                "id": "ac",
