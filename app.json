      "energy": {
        "batteries": [
          "INTERNAL"
        ]
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud",
        "ble"
      ],
      "images": {
        "small": "/drivers/power_station/assets/images/small.png",
        "large": "/drivers/power_station/assets/images/large.png",
        "xlarge": "/drivers/power_station/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_oauth2",
          "template": "login_oauth2"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_oauth2",
          "template": "login_oauth2"
        }
      ],
      "id": "power_station",
      "settings": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Update interval without real-time link"
          },
          "hint": {
            "en": "Changes are pushed instantly by the BLUETTI cloud. While that real-time link is connected, Homey only reads every 5 minutes as a safety net. This interval is used when the link is down or the power station is offline."
          },
          "value": 30,
          "min": 15,
          "max": 600,
          "units": {
            "en": "seconds"
          }
        },
        {
          "id": "capacity_wh",
          "type": "number",
          "value": 0,
          "min": 0,
          "max": 100000,
          "label": {
            "en": "Battery capacity"
          },
          "units": {
            "en": "Wh"
          },
          "hint": {
            "en": "Used for the Backup time estimate. Filled in automatically for the Elite 30 V2 (288 Wh). For other models, enter the capacity from the label or manual, including any expansion batteries. 0 hides Backup time."
          }
        },
        {
          "type": "group",
          "label": {
            "en": "Bluetooth fallback"
          },
          "children": [
            {
              "id": "ble_fallback",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "Read over Bluetooth when the cloud is unavailable"
              },
              "hint": {
                "en": "When Wi-Fi or the BLUETTI cloud is down, Homey reads battery level, power and time remaining directly from the power station over Bluetooth (read only). Homey must be within Bluetooth range. Turning this on runs a test read right away. Tested with Elite 30 V2."
              }
            },
            {
              "id": "ble_status",
              "type": "label",
              "label": {
                "en": "Last Bluetooth read"
              },
              "value": "–"
            }
          ]
        },
        {
          "id": "sn",
          "type": "label",
          "label": {
            "en": "Serial number"
          },
          "value": ""
        },
        {
          "id": "model",
          "type": "label",
          "label": {
            "en": "Model"
          },
          "value": ""
        },
        {
          "type": "group",
          "label": {
            "en": "Notifications"
          },
          "children": [
            {
              "id": "timeline_notifications",
              "type": "checkbox",
              "value": true,
              "label": {
                "en": "Timeline notifications"
              },
              "hint": {
                "en": "Post a message to the Homey timeline when the power station goes offline, comes back online, or the BLUETTI login needs to be renewed."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Diagnostics"
          },
          "children": [
            {
              "id": "debug_logging",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "Detailed logging"
              },
              "hint": {
                "en": "Writes every cloud reading and real-time notification to the app log. Turn this on, wait a few minutes, then send a diagnostics report from the app page. No passwords or tokens are logged."
              }
            }
          ]
        }
      ]
    }
  ],
