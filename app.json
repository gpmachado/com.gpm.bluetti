        "measure_power.grid_in": {
          "title": {
            "en": "Grid input"
          }
        },
        "measure_power.ac_out": {
          "title": {
            "en": "AC output"
          }
        },
        "measure_power.dc_out": {
          "title": {
            "en": "DC output"
          }
        },
        "onoff.ac": {
          "title": {
            "en": "AC output"
          },
          "uiComponent": "button"
        },
        "onoff.dc": {
          "title": {
            "en": "DC output"
          },
          "uiComponent": "button"
        },
        "onoff.ac_eco": {
          "title": {
            "en": "AC ECO"
          },
          "uiComponent": "button"
        },
        "onoff.dc_eco": {
          "title": {
            "en": "DC ECO"
          },
          "uiComponent": "button"
        }
